# Clarity AI - Backend Configuration

# Backend server port
PORT=8000

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./chroma_db

# Ollama configuration
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Logging level
LOG_LEVEL=INFO